{
  "name": "Ticket Classification",
  "nodes": [
    {
      "id": "n1",
      "name": "New Ticket Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "support-classify-ticket",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "AI Classify Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/support/classify",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "ticket_id",
              "value": "={{ $json.ticket_id }}"
            },
            {
              "name": "subject",
              "value": "={{ $json.subject }}"
            },
            {
              "name": "description",
              "value": "={{ $json.description }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Update Ticket Classification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE support_tickets SET category = '{{ $json.category }}', subcategory = '{{ $json.subcategory }}', priority = '{{ $json.priority }}', assigned_team = '{{ $json.assigned_team }}', classified_at = NOW() WHERE id = {{ $json.ticket_id }}"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n4",
      "name": "Route to Appropriate Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "={{ $json.team_slack_channel }}",
        "text": ":ticket: New {{ $json.priority }} priority ticket assigned to your team!\nTicket: TKT-{{ $json.ticket_id }}\nCategory: {{ $json.category }} / {{ $json.subcategory }}\nSubject: {{ $json.subject }}\nView: https://support.company.com/tickets/{{ $json.ticket_id }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "New Ticket Webhook": {
      "main": [
        [
          {
            "node": "AI Classify Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Classify Ticket": {
      "main": [
        [
          {
            "node": "Update Ticket Classification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Ticket Classification": {
      "main": [
        [
          {
            "node": "Route to Appropriate Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-sup-87",
  "tags": [
    "support",
    "ai"
  ]
}