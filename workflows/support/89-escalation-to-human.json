{
  "name": "Escalation to Human",
  "nodes": [
    {
      "id": "n1",
      "name": "Escalation Check Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "support-escalation",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Check Escalation Need",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/support/escalation-check",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "ticket_id",
              "value": "={{ $json.ticket_id }}"
            },
            {
              "name": "conversation_history",
              "value": "={{ $json.conversation_history }}"
            },
            {
              "name": "sentiment",
              "value": "={{ $json.sentiment }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Should Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.escalate }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Update Ticket for Human",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        750,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE support_tickets SET status = 'escalated', escalated_at = NOW(), escalation_reason = '{{ $json.escalation_reason }}' WHERE id = {{ $json.ticket_id }}"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n5",
      "name": "Alert Human Support Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#support-escalations",
        "text": ":sos: *ESCALATION REQUIRED*\nTicket: TKT-{{ $json.ticket_id }}\nCustomer: {{ $json.customer_name }}\nReason: {{ $json.escalation_reason }}\nSentiment: {{ $json.sentiment }}\nView: https://support.company.com/tickets/{{ $json.ticket_id }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n6",
      "name": "No Escalation Needed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        750,
        400
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Escalation Check Webhook": {
      "main": [
        [
          {
            "node": "Check Escalation Need",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Escalation Need": {
      "main": [
        [
          {
            "node": "Should Escalate?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Escalate?": {
      "main": [
        [
          {
            "node": "Update Ticket for Human",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Escalation Needed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Ticket for Human": {
      "main": [
        [
          {
            "node": "Alert Human Support Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-sup-89",
  "tags": []
}