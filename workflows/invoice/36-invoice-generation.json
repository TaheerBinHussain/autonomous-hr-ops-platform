{
  "name": "Invoice Generation",
  "nodes": [
    {
      "id": "n1",
      "name": "Deal Close Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-generate",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Generate Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/invoice/generate",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "deal_id",
              "value": "={{ $json.deal_id }}"
            },
            {
              "name": "customer_id",
              "value": "={{ $json.customer_id }}"
            },
            {
              "name": "amount",
              "value": "={{ $json.amount }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Save to MinIO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "parameters": {
        "url": "http://minio:9000/invoices/{{ $json.invoice_number }}.pdf",
        "method": "PUT",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.pdf_base64 }}"
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Send Invoice to Client",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "toEmail": "={{ $json.client_email }}",
        "subject": "Invoice #{{ $json.invoice_number }} \u2014 {{ $json.company_name }}",
        "message": "Dear {{ $json.client_name }},\n\nPlease find your invoice #{{ $json.invoice_number }} for ${{ $json.amount }}.\n\nDue Date: {{ $json.due_date }}\nDownload: {{ $json.invoice_url }}\nPay Online: {{ $json.payment_link }}\n\nThank you for your business!\nFinance Team",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp-cred-1",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Deal Close Webhook": {
      "main": [
        [
          {
            "node": "Generate Invoice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Invoice": {
      "main": [
        [
          {
            "node": "Save to MinIO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to MinIO": {
      "main": [
        [
          {
            "node": "Send Invoice to Client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-inv-36",
  "tags": [
    "invoice",
    "finance"
  ]
}