{
  "name": "Resume Screening",
  "nodes": [
    {
      "id": "n1",
      "name": "Resume Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "resume-screening",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "AI Screen Resume",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/hr/screen-resume",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "resume_text",
              "value": "={{ $json.resume_text }}"
            },
            {
              "name": "job_id",
              "value": "={{ $json.job_id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Save Screening Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO resume_screenings (candidate_id, job_id, score, summary, screened_at) VALUES ('{{ $json.candidate_id }}', '{{ $json.job_id }}', {{ $json.score }}, '{{ $json.summary }}', NOW())"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n4",
      "name": "Notify HR Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#hr-recruiting",
        "text": "New resume screened for {{ $json.job_id }} \u2014 Score: {{ $json.score }}/100. Candidate: {{ $json.candidate_name }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Resume Webhook": {
      "main": [
        [
          {
            "node": "AI Screen Resume",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Screen Resume": {
      "main": [
        [
          {
            "node": "Save Screening Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Screening Result": {
      "main": [
        [
          {
            "node": "Notify HR Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-hr-02",
  "tags": []
}