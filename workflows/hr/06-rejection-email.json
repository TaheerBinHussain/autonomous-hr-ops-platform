{
  "name": "Rejection Email",
  "nodes": [
    {
      "id": "n1",
      "name": "Rejection Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "rejection-email",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Generate Rejection Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/hr/generate-rejection-email",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "candidate_id",
              "value": "={{ $json.candidate_id }}"
            },
            {
              "name": "job_title",
              "value": "={{ $json.job_title }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Update Candidate Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE candidates SET status = 'rejected', rejection_sent_at = NOW() WHERE id = {{ $json.candidate_id }}"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n4",
      "name": "Send Rejection Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "toEmail": "={{ $json.candidate_email }}",
        "subject": "Update on Your Application \u2014 {{ $json.job_title }}",
        "message": "={{ $json.email_body }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp-cred-1",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Rejection Webhook": {
      "main": [
        [
          {
            "node": "Generate Rejection Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Rejection Email": {
      "main": [
        [
          {
            "node": "Update Candidate Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Candidate Status": {
      "main": [
        [
          {
            "node": "Send Rejection Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-hr-06",
  "tags": []
}