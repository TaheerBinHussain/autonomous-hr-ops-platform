{
  "name": "New Hire Announcement",
  "nodes": [
    {
      "id": "n1",
      "name": "New Hire Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "new-hire-announcement",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Format Announcement",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        250,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "assign-0",
              "name": "announcement",
              "value": "=:wave: We're excited to announce that *{{ $json.first_name }} {{ $json.last_name }}* is joining us as *{{ $json.role }}* in the *{{ $json.department }}* department starting {{ $json.start_date }}!\n\n{{ $json.bio }}\n\nPlease join us in welcoming them to the team!",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Post to General",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#general",
        "text": "={{ $json.announcement }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n4",
      "name": "Post to Department Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "={{ $json.team_channel }}",
        "text": ":handshake: Your new teammate *{{ $json.first_name }}* is joining on {{ $json.start_date }}. Start date is {{ $json.start_date }}. Get ready to welcome them!"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "New Hire Webhook": {
      "main": [
        [
          {
            "node": "Format Announcement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Announcement": {
      "main": [
        [
          {
            "node": "Post to General",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to General": {
      "main": [
        [
          {
            "node": "Post to Department Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-hr-17",
  "tags": [
    "hr",
    "onboarding"
  ]
}