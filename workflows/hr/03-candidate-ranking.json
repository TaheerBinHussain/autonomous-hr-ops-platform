{
  "name": "Candidate Ranking",
  "nodes": [
    {
      "id": "n1",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Fetch Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.*, rs.score FROM candidates c JOIN resume_screenings rs ON c.id = rs.candidate_id WHERE c.status = 'active' ORDER BY rs.score DESC"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n3",
      "name": "Rank Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ranked = items.map((item, idx) => ({\n  ...item.json,\n  rank: idx + 1,\n  tier: idx < 5 ? 'A' : idx < 15 ? 'B' : 'C'\n}));\nreturn ranked.map(r => ({json: r}));"
      }
    },
    {
      "id": "n4",
      "name": "Update Rankings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE candidates SET rank = {{ $json.rank }}, tier = '{{ $json.tier }}' WHERE id = {{ $json.id }}"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Fetch Candidates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Candidates": {
      "main": [
        [
          {
            "node": "Rank Candidates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rank Candidates": {
      "main": [
        [
          {
            "node": "Update Rankings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-hr-03",
  "tags": []
}