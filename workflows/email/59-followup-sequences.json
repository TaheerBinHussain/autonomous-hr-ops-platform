{
  "name": "Follow-up Sequences",
  "nodes": [
    {
      "id": "n1",
      "name": "Daily Followup Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Fetch Due Follow-up Steps",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT fs.*, c.email, c.name FROM followup_sequence_steps fs JOIN customers c ON fs.customer_id = c.id WHERE fs.status = 'pending' AND fs.scheduled_for <= NOW() ORDER BY fs.scheduled_for ASC LIMIT 100"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n3",
      "name": "Prepare Email Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "assign-0",
              "name": "to_email",
              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "assign-1",
              "name": "subject",
              "value": "={{ $json.email_subject }}",
              "type": "string"
            },
            {
              "id": "assign-2",
              "name": "body",
              "value": "={{ $json.email_body }}",
              "type": "string"
            },
            {
              "id": "assign-3",
              "name": "step_id",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Send Follow-up Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "toEmail": "={{ $json.to_email }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp-cred-1",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Daily Followup Check": {
      "main": [
        [
          {
            "node": "Fetch Due Follow-up Steps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Follow-up Steps": {
      "main": [
        [
          {
            "node": "Prepare Email Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Email Data": {
      "main": [
        [
          {
            "node": "Send Follow-up Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-email-59",
  "tags": [
    "email",
    "crm"
  ]
}