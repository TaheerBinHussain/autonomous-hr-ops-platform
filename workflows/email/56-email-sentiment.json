{
  "name": "Email Sentiment Analysis",
  "nodes": [
    {
      "id": "n1",
      "name": "Email Sentiment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "email-sentiment",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "AI Sentiment Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/email/sentiment",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "subject",
              "value": "={{ $json.subject }}"
            },
            {
              "name": "body",
              "value": "={{ $json.body }}"
            },
            {
              "name": "sender",
              "value": "={{ $json.from }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Save Sentiment Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO email_sentiment_log (email_id, sender, subject, sentiment, sentiment_score, flags, analyzed_at) VALUES ('{{ $json.email_id }}', '{{ $json.from }}', '{{ $json.subject }}', '{{ $json.sentiment }}', {{ $json.sentiment_score }}, '{{ $json.flags }}', NOW())"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n4",
      "name": "Negative Sentiment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.sentiment }}",
              "rightValue": "negative",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n5",
      "name": "Flag for Immediate Attention",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#customer-success-alerts",
        "text": ":warning: Negative Email Detected!\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nSentiment Score: {{ $json.sentiment_score }}/10\nFlags: {{ $json.flags }}\nPlease respond within 2 hours."
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n6",
      "name": "Positive/Neutral Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Email Sentiment Webhook": {
      "main": [
        [
          {
            "node": "AI Sentiment Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Sentiment Analysis": {
      "main": [
        [
          {
            "node": "Save Sentiment Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Sentiment Result": {
      "main": [
        [
          {
            "node": "Negative Sentiment?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Negative Sentiment?": {
      "main": [
        [
          {
            "node": "Flag for Immediate Attention",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Positive/Neutral Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-email-56",
  "tags": []
}