{
  "name": "WhatsApp Urgent Notification",
  "nodes": [
    {
      "id": "n1",
      "name": "High Priority Email Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-urgent",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Is High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.priority }}",
              "rightValue": "urgent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Send WhatsApp Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        200
      ],
      "parameters": {
        "url": "https://api.whatsapp-provider.com/v1/messages",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $json.recipient_phone }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "\ud83d\udea8 URGENT Email: {{ $json.subject }}\nFrom: {{ $json.from }}\nSummary: {{ $json.summary }}\n\nCheck your inbox immediately."
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Non-Urgent Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        500,
        400
      ],
      "parameters": {}
    },
    {
      "id": "n5",
      "name": "Log WhatsApp Notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        750,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO whatsapp_notifications (email_id, recipient, message, sent_at) VALUES ('{{ $json.email_id }}', '{{ $json.recipient_phone }}', '{{ $json.subject }}', NOW())"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    }
  ],
  "connections": {
    "High Priority Email Webhook": {
      "main": [
        [
          {
            "node": "Is High Priority?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is High Priority?": {
      "main": [
        [
          {
            "node": "Send WhatsApp Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Non-Urgent Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Notification": {
      "main": [
        [
          {
            "node": "Log WhatsApp Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-email-55",
  "tags": []
}