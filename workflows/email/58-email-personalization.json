{
  "name": "Email Personalization",
  "nodes": [
    {
      "id": "n1",
      "name": "Email Personalize Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "email-personalization",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Fetch Customer Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.*, s.plan_name, c.last_login, c.total_orders FROM customers c LEFT JOIN subscriptions s ON c.subscription_id = s.id WHERE c.id = {{ $json.customer_id }}"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n3",
      "name": "Personalize Email Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/email/personalize",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "template_id",
              "value": "={{ $json.template_id }}"
            },
            {
              "name": "customer_data",
              "value": "={{ $json }}"
            },
            {
              "name": "context",
              "value": "={{ $json.context }}"
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Send Personalized Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.personalized_subject }}",
        "message": "={{ $json.personalized_body }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp-cred-1",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Email Personalize Webhook": {
      "main": [
        [
          {
            "node": "Fetch Customer Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Customer Data": {
      "main": [
        [
          {
            "node": "Personalize Email Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Personalize Email Template": {
      "main": [
        [
          {
            "node": "Send Personalized Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-email-58",
  "tags": []
}