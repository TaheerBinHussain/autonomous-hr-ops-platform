{
  "name": "Email Triage",
  "nodes": [
    {
      "id": "n1",
      "name": "Email Inbox Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "email-triage",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "AI Classify Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/email/classify",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "subject",
              "value": "={{ $json.subject }}"
            },
            {
              "name": "body",
              "value": "={{ $json.body }}"
            },
            {
              "name": "sender",
              "value": "={{ $json.from }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Is Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.urgency }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Alert Responsible Person",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        750,
        200
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "={{ $json.assigned_slack_channel }}",
        "text": ":rotating_light: URGENT Email!\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nCategory: {{ $json.category }}\nSummary: {{ $json.ai_summary }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n5",
      "name": "Log Email & Route",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        750,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO email_triage_log (sender, subject, urgency, category, assigned_to, received_at) VALUES ('{{ $json.from }}', '{{ $json.subject }}', '{{ $json.urgency }}', '{{ $json.category }}', '{{ $json.assigned_to }}', NOW())"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    }
  ],
  "connections": {
    "Email Inbox Webhook": {
      "main": [
        [
          {
            "node": "AI Classify Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Classify Email": {
      "main": [
        [
          {
            "node": "Is Urgent?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Urgent?": {
      "main": [
        [
          {
            "node": "Alert Responsible Person",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Email & Route",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-email-51",
  "tags": [
    "email",
    "ai"
  ]
}