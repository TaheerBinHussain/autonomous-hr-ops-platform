{
  "name": "Lead Capture",
  "nodes": [
    {
      "id": "n1",
      "name": "Lead Capture Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "Save Lead to DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (name, email, phone, company, source, created_at) VALUES ('{{ $json.name }}', '{{ $json.email }}', '{{ $json.phone }}', '{{ $json.company }}', '{{ $json.source }}', NOW()) RETURNING id"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n3",
      "name": "Trigger Nurture Sequence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/crm/start-nurture",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "source",
              "value": "={{ $json.source }}"
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Notify Sales Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#crm-leads",
        "text": ":mega: New lead captured!\nName: *{{ $json.name }}*\nCompany: {{ $json.company }}\nSource: {{ $json.source }}\nEmail: {{ $json.email }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Lead Capture Webhook": {
      "main": [
        [
          {
            "node": "Save Lead to DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Lead to DB": {
      "main": [
        [
          {
            "node": "Trigger Nurture Sequence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Nurture Sequence": {
      "main": [
        [
          {
            "node": "Notify Sales Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-crm-21",
  "tags": [
    "crm",
    "leads"
  ]
}