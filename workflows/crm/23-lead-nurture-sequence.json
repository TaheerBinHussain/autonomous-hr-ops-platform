{
  "name": "Lead Nurture Sequence",
  "nodes": [
    {
      "id": "n1",
      "name": "Daily Nurture Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Fetch Leads by Stage",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, ns.sequence_day, ns.email_template FROM leads l JOIN nurture_sequences ns ON l.nurture_stage = ns.stage WHERE l.status = 'nurturing' AND l.last_email_sent < NOW() - INTERVAL '1 day' * ns.interval_days"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n3",
      "name": "Personalize Email Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/crm/personalize-email",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "template",
              "value": "={{ $json.email_template }}"
            },
            {
              "name": "stage",
              "value": "={{ $json.nurture_stage }}"
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Send Nurture Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.email_subject }}",
        "message": "={{ $json.personalized_content }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp-cred-1",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Daily Nurture Schedule": {
      "main": [
        [
          {
            "node": "Fetch Leads by Stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Leads by Stage": {
      "main": [
        [
          {
            "node": "Personalize Email Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Personalize Email Content": {
      "main": [
        [
          {
            "node": "Send Nurture Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-crm-23",
  "tags": [
    "crm",
    "email",
    "leads"
  ]
}