{
  "name": "Churn Prediction",
  "nodes": [
    {
      "id": "n1",
      "name": "Weekly Churn Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Fetch Active Customers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, email, last_login, usage_hours, support_tickets FROM customers WHERE status = 'active'"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n3",
      "name": "Predict Churn Risk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/crm/churn-prediction",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "customer_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "usage_data",
              "value": "={{ $json }}"
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "High Churn Risk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.churn_probability }}",
              "rightValue": "0.7",
              "operator": {
                "type": "string",
                "operation": "largerEqual"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n5",
      "name": "Alert Customer Success",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#crm-churn-risk",
        "text": ":warning: HIGH CHURN RISK!\nCustomer: *{{ $json.customer_name }}*\nChurn Probability: *{{ ($json.churn_probability * 100).toFixed(0) }}%*\nKey Reason: {{ $json.primary_reason }}\nAction: Schedule retention call immediately."
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n6",
      "name": "Low Risk - Continue",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Weekly Churn Check": {
      "main": [
        [
          {
            "node": "Fetch Active Customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Active Customers": {
      "main": [
        [
          {
            "node": "Predict Churn Risk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Predict Churn Risk": {
      "main": [
        [
          {
            "node": "High Churn Risk?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Churn Risk?": {
      "main": [
        [
          {
            "node": "Alert Customer Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Low Risk - Continue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-crm-26",
  "tags": [
    "crm",
    "ai",
    "retention"
  ]
}