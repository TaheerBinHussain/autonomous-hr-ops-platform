{
  "name": "Lead Scoring",
  "nodes": [
    {
      "id": "n1",
      "name": "Lead Score Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-scoring",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "n2",
      "name": "AI Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        300
      ],
      "parameters": {
        "url": "http://ai-backend:8000/crm/score-lead",
        "method": "POST",
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $json.lead_id }}"
            },
            {
              "name": "behavior_data",
              "value": "={{ $json.behavior_data }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3",
      "name": "Update Lead Score",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET score = {{ $json.score }}, score_updated_at = NOW(), tier = '{{ $json.tier }}' WHERE id = {{ $json.lead_id }}"
      },
      "credentials": {
        "postgres": {
          "id": "pg-cred-1",
          "name": "Postgres DB"
        }
      }
    },
    {
      "id": "n4",
      "name": "Hot Lead Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.score }}",
              "rightValue": "80",
              "operator": {
                "type": "string",
                "operation": "largerEqual"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n5",
      "name": "Alert Hot Lead",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "operation": "postMessage",
        "channel": "#crm-hot-leads",
        "text": ":fire: HOT LEAD ALERT!\n*{{ $json.lead_name }}* from {{ $json.company }} scored *{{ $json.score }}/100*.\nAssigned to: {{ $json.assigned_rep }}\nAction: Contact within 1 hour!"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-1",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n6",
      "name": "Regular Lead - No Action",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Lead Score Webhook": {
      "main": [
        [
          {
            "node": "AI Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Score Lead": {
      "main": [
        [
          {
            "node": "Update Lead Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Lead Score": {
      "main": [
        [
          {
            "node": "Hot Lead Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hot Lead Check": {
      "main": [
        [
          {
            "node": "Alert Hot Lead",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Regular Lead - No Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-crm-22",
  "tags": [
    "crm",
    "leads",
    "ai"
  ]
}